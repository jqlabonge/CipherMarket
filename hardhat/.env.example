# Copy to .env and fill in. Never commit your real .env.

# A Base Sepolia RPC URL (the public default below works, or use your own
# Alchemy/Infura endpoint for reliability).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Private key of the deployer wallet. TESTNET FUNDS ONLY. Never your real wallet.
PRIVATE_KEY=

# Optional, for `hardhat verify` on Basescan.
BASESCAN_API_KEY=
