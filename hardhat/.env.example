# Copy to .env and fill in. Never commit your real .env.

# Ethereum Sepolia RPC URL (primary deploy target) -- e.g. an Alchemy or
# Infura endpoint. No public default is hardcoded for Sepolia, so this must
# be set.
SEPOLIA_RPC_URL=

# Private key of the deployer wallet. TESTNET FUNDS ONLY. Never your real wallet.
PRIVATE_KEY=

# Optional, for `hardhat verify` on Etherscan (Sepolia).
ETHERSCAN_API_KEY=

# --- Base Sepolia (kept as an additional option, not required) ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=
